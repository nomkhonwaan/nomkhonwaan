  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rust: Debug day1",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "run",
          "--bin=day1",
        ],
        "filter": {
          "name": "day1",
          "kind": "bin"
        },
        "cwd": "${workspaceFolder}/advent-of-code/2025"
      },
      "args": [
        "src/bin/day1/input_example.txt"
      ],
      "stopOnEntry": false,
      "console": "integratedTerminal"
    }
  ]
}